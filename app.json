{
  "expo": {
    "name": "XChangoProject",
    "slug": "XChangoProject",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "xchangoproject",
    "deepLinks": ["xchangoproject://verify-email"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.anonymous.XChangoProject",
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.XChangoProject"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen", 
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ee5ee05-47ba-49ad-8c75-e556c3be0851"
      }
    }
  }
}
